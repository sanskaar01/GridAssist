# GridAssist Monorepo Root Environment Configuration Example

# Backend Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=*

# PostgreSQL Database Configuration
POSTGRES_USER=gridassist
POSTGRES_PASSWORD=gridassist_pass
POSTGRES_DB=gridassist_db
DATABASE_URL=postgresql://gridassist:gridassist_pass@localhost:5432/gridassist_db?schema=public

# Frontend Configuration
VITE_API_URL=http://localhost:3000/api/v1
